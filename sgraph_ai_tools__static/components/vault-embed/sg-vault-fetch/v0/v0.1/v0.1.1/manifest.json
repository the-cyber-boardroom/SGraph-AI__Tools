{
    "name": "sg-vault-fetch",
    "version": "0.1.1",
    "type": "component",
    "namespace": "vault-embed",
    "tag": "sg-vault-fetch",
    "description": "Fetches one encrypted vault blob by object ID, decrypts it, emits content-ready with bytes and content type. Empty shadow root.",
    "attributes": {
        "key-source": { "required": true,  "type": "string", "description": "ID of an <sg-vault-key> element" },
        "object-id":  { "required": true,  "type": "string", "description": "obj-cas-imm-* content-addressed blob ID" },
        "auto":       { "required": false, "type": "bool-attr", "default": "present", "description": "When present, fetches on onReady" }
    },
    "events": {
        "sg-vault-fetch:fetch-started":     { "detail": "{ vaultId, objectId, url }" },
        "sg-vault-fetch:fetch-completed":   { "detail": "{ vaultId, objectId, bytesReceived, fetchMs, cacheHit }" },
        "sg-vault-fetch:decrypt-started":   { "detail": "{ objectId, ciphertextBytes }" },
        "sg-vault-fetch:decrypt-completed": { "detail": "{ objectId, plaintextBytes, decryptMs }" },
        "sg-vault-fetch:content-ready":     { "detail": "{ objectId, bytes, contentType, text }" },
        "sg-vault-fetch:fetch-error":       { "detail": "{ stage, objectId, error }" }
    },
    "methods": {
        "fetch":           { "async": true,  "returns": "Promise<void>", "description": "Trigger fetch+decrypt manually (when auto is absent)" },
        "getCurrentContent": { "async": false, "returns": "{ bytes, contentType, text }|null" }
    },
    "dependencies": {
        "core": [
            { "module": "sg-component",   "path": "/components/base/v1/v1.0/v1.0.0/sg-component.js" },
            { "module": "sg-vault-client","path": "/core/vault-client/v1/v1.2/v1.2.3/sg-vault-client.js" }
        ],
        "shared": [
            { "module": "sg-vault-key",   "path": "/components/vault-embed/sg-vault-key/v0/v0.1/v0.1.1/sg-vault-key.js" }
        ]
    }
}
