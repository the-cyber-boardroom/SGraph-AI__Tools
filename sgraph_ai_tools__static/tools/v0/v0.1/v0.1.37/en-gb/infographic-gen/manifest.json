{
  "name": "Infographic Generator",
  "slug": "infographic-gen",
  "description": "Generate infographics from text or documents using image-capable LLM models.",
  "icon": "🎨",
  "version": "0.1.37",
  "status": "live",
  "category": "ai",
  "keywords": ["infographic", "llm", "openrouter", "image", "ai", "svg"],
  "dependencies": {
    "core": [
      { "module": "sg-layout",     "path": "/core/sg-layout/v0.1.0/sg-layout.js" },
      { "module": "sg-tool-api",   "path": "/core/sg-tool-api/v0/v0.1/v0.1.0/sg-tool-api.js" }
    ],
    "components": [
      { "module": "sg-llm-request",              "path": "/components/llm/sg-llm-request/v0/v0.1/v0.1.2/sg-llm-request.js" },
      { "module": "sg-llm-stats",                "path": "/components/llm/sg-llm-stats/v0/v0.1/v0.1.1/sg-llm-stats.js" },
      { "module": "sg-llm-infographic",          "path": "/components/llm/sg-llm-infographic/v0/v0.1/v0.1.0/sg-llm-infographic.js" },
      { "module": "sg-openrouter-generation",    "path": "/components/openrouter/sg-openrouter-generation/v0/v0.1/v0.1.1/sg-openrouter-generation.js" },
      { "module": "sg-infographic-model-picker", "path": "/components/infographic/sg-infographic-model-picker/v0/v0.1/v0.1.0/sg-infographic-model-picker.js" },
      { "module": "sg-infographic-export",       "path": "/components/infographic/sg-infographic-export/v0/v0.1/v0.1.0/sg-infographic-export.js" },
      { "module": "sg-tool-api-explorer",        "path": "/components/tool-api/sg-tool-api-explorer/v0/v0.1/v0.1.0/sg-tool-api-explorer.js" },
      { "module": "sg-tool-api-console",         "path": "/components/tool-api/sg-tool-api-console/v0/v0.1/v0.1.0/sg-tool-api-console.js" },
      { "module": "sg-tool-api-manifest",        "path": "/components/tool-api/sg-tool-api-manifest/v0/v0.1/v0.1.0/sg-tool-api-manifest.js" }
    ],
    "shared": [
      { "module": "sg-site-header", "path": "/components/site-header/v1/v1.0/v1.0.2/sg-site-header.js" }
    ]
  },
  "api": {
    "version": "0.1.0",
    "note": "window.__tool is live. window.__tool_registry.find('infographic-generator') for multi-instance.",
    "events": [
      { "name": "tool:ready",                "when": "activate() called",            "detail": "{ instanceId, tool, version }" },
      { "name": "tool:connected",            "when": "OpenRouter connect succeeds",  "detail": "{ instanceId, provider, model }" },
      { "name": "tool:generation:started",   "when": "send fired",                  "detail": "{ instanceId, callId, generationId, model, prompt }" },
      { "name": "tool:generation:complete",  "when": "request finishes",            "detail": "{ instanceId, callId, generationId, model, duration, imageSrc }" },
      { "name": "tool:generation:error",     "when": "request fails",               "detail": "{ instanceId, callId, model, error }" },
      { "name": "tool:generation:cancelled", "when": "user cancels",                "detail": "{ instanceId, callId, generationId }" }
    ],
    "actions": {
      "connect": {
        "params": {
          "apiKey": { "type": "string", "secret": true, "optional": true },
          "model":  { "type": "string", "optional": true }
        },
        "returns": "Promise<{ model: string, provider: string }>",
        "async": true,
        "note": "Skip-if-same-key: resolves immediately without network if apiKey+model unchanged."
      },
      "generate": {
        "params": {
          "prompt":   { "type": "string",  "optional": true },
          "model":    { "type": "string",  "optional": true },
          "renderUI": { "type": "boolean", "optional": true, "note": "false = headless; LLM request runs but no result tab is created" }
        },
        "returns": "Promise<{ instanceId, callId, generationId, model, duration, imageSrc }>",
        "async": true,
        "note": "callId (UUID) echoed in all window events for precise concurrent Promise correlation."
      },
      "getState": {
        "params": {},
        "returns": "{ mode, prompt, model, connected, activeGenerations, systemPrompt, document, image }",
        "async": false
      },
      "getGenerations": {
        "params": {
          "n": { "type": "number", "optional": true, "note": "Max records to return, newest-first. Omit for all (ring buffer: last 50)." }
        },
        "returns": "Array<{ callId, generationId, timestamp, model, prompt, request: { messages, model }, response: { content, promptTokens, completionTokens, latencyMs, finishReason, images, rawChunks, rawResponse }, imageSrc, duration, status, error }>",
        "async": false,
        "note": "Full request/response audit trail. request.messages is the exact multimodal array sent. response mirrors REQUEST_COMPLETE detail from sg-llm-request."
      },
      "setSystemPrompt": {
        "params": { "0": { "type": "string", "note": "Pass empty string to reset to the default prompt for the current mode." } },
        "returns": "void",
        "async": false,
        "note": "Sets the system prompt textarea. Takes effect on the next generate() call. Pass '' to clear (next send will fall back to the mode default)."
      },
      "getSystemPrompt": {
        "params": {},
        "returns": "string",
        "async": false,
        "note": "Returns the current value of the system prompt textarea (may be the mode default or an override)."
      },
      "setPrompt":   { "params": { "0": { "type": "string" } }, "returns": "void",   "async": false },
      "getPrompt":   { "params": {}, "returns": "string",                              "async": false },
      "setModel":    { "params": { "0": { "type": "string" } }, "returns": "void",   "async": false },
      "getModel":    { "params": {}, "returns": "string",                              "async": false },
      "setTemplate": {
        "params": { "0": { "type": "string", "note": "id or label: executive, architecture, timeline, comparison, process, stats, mindmap" } },
        "returns": "string (the prompt text)",
        "async": false
      },
      "stop": { "params": {}, "returns": "void", "async": false, "note": "Cancels all active generations." }
    },
    "skills": {
      "human":   "./SKILL-human.md",
      "browser": "./SKILL-browser.md",
      "api":     "./SKILL-api.md"
    }
  }
}
