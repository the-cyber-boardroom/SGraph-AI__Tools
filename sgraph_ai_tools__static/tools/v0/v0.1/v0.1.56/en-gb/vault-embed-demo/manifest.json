{
    "id": "vault-embed-demo",
    "name": "Vault Embed Demo",
    "slug": "vault-embed-demo",
    "description": "Live demonstration of the public-vault embed component suite. Fetches encrypted blobs from send.sgraph.ai, decrypts client-side, renders markdown/image/JSON, and shows the full event trace.",
    "icon": "🔐",
    "version": "0.1.0",
    "status": "dev",
    "category": "vault",
    "keywords": ["vault", "embed", "decrypt", "web-crypto", "aes-gcm", "components"],
    "locale": "en-gb",
    "loader": [
        { "phase": 1, "type": "css", "path": "/components/tokens/v1/v1.0/v1.0.0/sg-tokens.css" },
        { "phase": 1, "type": "css", "path": "./styles/vault-embed-demo.css" },
        { "phase": 2, "type": "js",  "path": "/components/base/v1/v1.0/v1.0.0/sg-component.js" },
        { "phase": 2, "type": "js",  "path": "/components/vault-embed/sg-vault-key/v0/v0.1/v0.1.0/sg-vault-key.js" },
        { "phase": 2, "type": "js",  "path": "/components/vault-embed/sg-vault-fetch/v0/v0.1/v0.1.0/sg-vault-fetch.js" },
        { "phase": 2, "type": "js",  "path": "/components/vault-embed/sg-vault-content/v0/v0.1/v0.1.0/sg-vault-content.js" },
        { "phase": 2, "type": "js",  "path": "/components/vault-embed/sg-vault-manifest/v0/v0.1/v0.1.0/sg-vault-manifest.js" },
        { "phase": 2, "type": "js",  "path": "/components/vault-embed/sg-vault-trace/v0/v0.1/v0.1.0/sg-vault-trace.js" },
