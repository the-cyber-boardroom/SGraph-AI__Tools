        { "phase": 3, "type": "js",  "entry": true, "path": "./ui/main.js" }
    ],
    "api": {
        "actions": {
            "getDemoVaultInfo": {
                "description": "Returns the demo vault's public credentials: { vaultId, readKey, endpoint, objectIds }."
            },
            "loadDemoContent": {
                "description": "Re-triggers a fetch+decrypt cycle for one slot. Params: { slot: 'hero'|'image'|'json' }. Useful for cache testing."
            },
            "getTraceLog": {
                "description": "Returns the last N events from the trace panel. Params: { limit?: number }."
            },
            "clearTraceLog": {
                "description": "Clears all events from the trace panel."
            },
            "setEndpoint": {
                "description": "Switch endpoint for testing. Params: { endpoint: string }."
            }
        }
    },
    "dependencies": {
        "core": [
            { "module": "sg-component",   "path": "/components/base/v1/v1.0/v1.0.0/sg-component.js" },
