{
    "version": "0.1.0",
    "name": "SGraph Tools UI",
    "description": "v0.1.0 — MVP tools landing page + SSH key generator",
    "base_locale": "en-gb",
    "locales": [
        "en-gb", "en-us", "fr-fr", "de-de", "es-es"
    ],
    "deploy": {
        "_comment": "Folders and files to sync to S3. Source of truth for what gets deployed.",
        "source_folders": [
            "_common",
            "en-gb",
            "i18n"
        ],
        "ci_generated_folders": [
            "en-us", "fr-fr", "de-de", "es-es"
        ],
        "ci_generate_command": "python scripts/generate_tools_i18n_pages.py",
        "root_files": [
            "index.html",
            "404.html",
            "robots.txt",
            "sitemap.xml",
            "manifest.json"
        ]
    },
    "files": {
        "index.html":                           { "type": "html", "role": "locale-redirect" },
        "404.html":                              { "type": "html", "role": "error-page" },
        "robots.txt":                            { "type": "txt",  "role": "seo" },
        "sitemap.xml":                           { "type": "xml",  "role": "seo" },
        "_common/css/tools.css":                 { "type": "css",  "role": "shared-styles" },
        "en-gb/index.html":                      { "type": "html", "role": "page", "page": "landing" },
        "en-gb/ssh-keygen/index.html":           { "type": "html", "role": "page", "page": "ssh-keygen" },
        "i18n/en-gb.json":                       { "type": "json", "role": "i18n-master" },
        "i18n/en-us.json":                       { "type": "json", "role": "i18n" },
        "i18n/fr-fr.json":                       { "type": "json", "role": "i18n" },
        "i18n/de-de.json":                       { "type": "json", "role": "i18n" },
        "i18n/es-es.json":                       { "type": "json", "role": "i18n" }
    },
    "tools": [
        "ssh-keygen"
    ],
    "ifd": {
        "frozen": true,
        "frozen_date": "2026-03-09",
        "next_version": "v0.1.1"
    }
}
