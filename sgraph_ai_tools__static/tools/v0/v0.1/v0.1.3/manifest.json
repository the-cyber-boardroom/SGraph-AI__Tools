{
    "version": "0.1.2",
    "name": "SGraph Tools UI",
    "description": "v0.1.3 — Cross-site nav, clean URLs, locale picker fix, environment parity",
    "base_locale": "en-gb",
    "locales": [
        "en-gb", "en-us", "fr-fr", "de-de", "es-es"
    ],
    "deploy": {
        "_comment": "Folders and files to sync to S3. Source of truth for what gets deployed.",
        "url_structure": "clean",
        "root_redirect": "locale-detect",
        "source_folders": [
            "_common",
            "en-gb",
            "i18n"
        ],
        "ci_generated_folders": [
            "en-us", "fr-fr", "de-de", "es-es"
        ],
        "ci_generate_command": "python scripts/generate_tools_i18n_pages.py",
        "root_files": [
            "index.html",
            "404.html",
            "robots.txt",
            "sitemap.xml",
            "manifest.json"
        ],
        "environments": {
            "dev":  "https://dev.tools.sgraph.ai",
            "main": "https://main.tools.sgraph.ai",
            "prod": "https://tools.sgraph.ai"
        },
        "sgraph_environments": {
            "dev":  "https://dev.sgraph.ai",
            "main": "https://main.sgraph.ai",
            "prod": "https://sgraph.ai"
        }
    },
    "files": {
        "index.html":                           { "type": "html", "role": "locale-redirect" },
        "404.html":                              { "type": "html", "role": "error-page" },
        "robots.txt":                            { "type": "txt",  "role": "seo" },
        "sitemap.xml":                           { "type": "xml",  "role": "seo" },
        "_common/css/tools.css":                 { "type": "css",  "role": "shared-styles" },
        "_common/js/sg-nav.js":                  { "type": "js",   "role": "shared-nav" },
        "en-gb/index.html":                      { "type": "html", "role": "page", "page": "landing" },
        "en-gb/ssh-keygen/index.html":           { "type": "html", "role": "page", "page": "ssh-keygen" },
        "en-gb/file-hasher/index.html":          { "type": "html", "role": "page", "page": "file-hasher" },
        "en-gb/file-encryptor/index.html":       { "type": "html", "role": "page", "page": "file-encryptor" },
        "en-gb/key-generator/index.html":        { "type": "html", "role": "page", "page": "key-generator" },
        "i18n/en-gb.json":                       { "type": "json", "role": "i18n-master" },
        "i18n/en-us.json":                       { "type": "json", "role": "i18n" },
        "i18n/fr-fr.json":                       { "type": "json", "role": "i18n" },
        "i18n/de-de.json":                       { "type": "json", "role": "i18n" },
        "i18n/es-es.json":                       { "type": "json", "role": "i18n" }
    },
    "tools": [
        "ssh-keygen",
        "file-hasher",
        "file-encryptor",
        "key-generator"
    ],
    "components": {
        "site-header": "v1.0.1",
        "site-footer": "v1.0.0",
        "locale-picker": "v1.0.1"
    },
    "changes_from": "0.1.1",
    "changes": [
        "Dynamic environment-aware cross-site nav (sg-nav.js)",
        "Locale picker v1.0.1 (CSS [hidden] fix, sessionStorage write)",
        "Clean URLs: base-path='/' instead of versioned path",
        "All asset paths use clean URL structure (/_common/, /en-gb/)",
        "Environment mapping in manifest for dev/main/prod parity",
        "17-locale support in locale redirect (up from 5)"
    ],
    "ifd": {
        "frozen": false,
        "next_version": "v0.1.3"
    }
}
