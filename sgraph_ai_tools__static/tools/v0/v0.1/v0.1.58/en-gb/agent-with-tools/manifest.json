    "api": {
        "version": "0.1.0",
        "global": "window.__tool",
        "events": ["tool:ready"],
        "actions": {
            "connect": {
                "description": "Ping the bridge; resolves with { ok, version, workspace }",
                "returns": "Promise<{ ok: boolean, version: string, workspace: string }>",
                "async": true
            },
            "chat": {
                "description": "Send a user message and await the final assistant text",
                "params": [{ "name": "msg", "type": "string" }],
                "returns": "Promise<string>",
                "async": true
            },
            "getTranscript": {
                "description": "Return the full turn array (user/assistant/tool turns)",
                "returns": "Array<object>"
            },
            "getBridgeStatus": {
                "description": "Return the last known bridge ping result",
                "returns": "{ ok: boolean, latency_ms: number, workspace: string } | null"
            },
            "setProvider": {
                "description": "Switch the LLM provider (ollama | openrouter)",
                "params": [{ "name": "name", "type": "string" }]
            },
            "setModel": {
                "description": "Set the model name on sg-llm-request",
                "params": [{ "name": "name", "type": "string" }]
            },
            "clearChat": {
                "description": "Reset conversation turns",
                "returns": "void"
            }
        }
    },
    "skills": {
        "human":   "./SKILL-human.md",
        "browser": "./SKILL-browser.md",
        "api":     "./SKILL-api.md"
    }
