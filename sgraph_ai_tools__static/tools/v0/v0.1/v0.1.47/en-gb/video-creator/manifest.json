{
  "name": "Video Creator",
  "slug": "video-creator",
  "description": "Browser-based narrated slideshow creator: upload slides, write narrations, generate Kokoro TTS audio, record with canvas + MediaRecorder, download WebM.",
  "icon": "🎬",
  "version": "0.1.47",
  "status": "live",
  "category": "ai",
  "keywords": ["video", "slides", "tts", "kokoro", "narration", "webm", "presentation", "wasm"],
  "dependencies": {
    "core": [
      { "module": "sg-tool-api",        "path": "/core/sg-tool-api/v0/v0.1/v0.1.0/sg-tool-api.js" },
      { "module": "sg-tts",             "path": "/core/sg-tts/v0/v0.1/v0.1.0/sg-tts.js" },
      { "module": "sg-video-recorder",  "path": "/core/sg-video-recorder/v0/v0.1/v0.1.0/sg-video-recorder.js" },
      { "module": "manifest-loader",    "path": "/core/manifest-loader/v0/v0.1/v0.1.0/manifest-loader.js" }
    ],
    "shared": [
      { "module": "sg-site-header", "path": "/components/site-header/v1/v1.0/v1.0.2/sg-site-header.js" }
    ],
    "loader": [
      { "phase": 1, "type": "css", "path": "./styles/video-creator.css" },
      { "phase": 1, "type": "css", "path": "./styles/slide-panel.css" },
      { "phase": 1, "type": "css", "path": "./styles/preview.css" },
      { "phase": 1, "type": "css", "path": "./styles/export.css" },
      { "phase": 3, "type": "js",  "entry": true, "path": "./api/video-api.js" }
    ]
  },
  "api": {
    "version": "0.1.0",
    "note": "window.__tool live after tool:ready. All processing is local — no server calls, no API key required.",
    "events": [
      { "name": "tool:ready",            "when": "activate() called",          "detail": "{ instanceId, tool, version }" },
      { "name": "tool:slides:loaded",    "when": "loadSlides() complete",      "detail": "{ count, slides: SlideInfo[] }" },
      { "name": "tool:audio:progress",   "when": "each TTS chunk generated",  "detail": "{ slideIndex, total }" },
      { "name": "tool:audio:complete",   "when": "all TTS audio generated",   "detail": "{ durations: number[] }" },
      { "name": "tool:record:start",     "when": "MediaRecorder started",      "detail": "{ fps }" },
      { "name": "tool:record:stop",      "when": "MediaRecorder stopped",      "detail": "{ durationMs }" },
      { "name": "tool:convert:start",    "when": "FFmpeg conversion begins",   "detail": "{}" },
      { "name": "tool:convert:progress", "when": "FFmpeg progress",            "detail": "{ ratio }" },
      { "name": "tool:convert:complete", "when": "MP4 ready",                  "detail": "{ mp4Blob }" },
      { "name": "tool:error",            "when": "any pipeline error",         "detail": "{ step, message }" }
    ],
    "skills": {
      "human":   "./skills/SKILL-human.md",
      "browser": "./skills/SKILL-browser.md",
      "api":     "./skills/SKILL-api.md"
    }
  }
}
