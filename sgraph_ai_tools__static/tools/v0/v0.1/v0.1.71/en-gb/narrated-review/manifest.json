{
  "name": "Narrated Review",
  "slug": "narrated-review",
  "description": "Narrate a walk through your screen and press a key at each moment that matters — or hand over a recording and let its pauses do the pressing. Either way you get an ordered list of captures (a screenshot, the words about it, and the alignment between them) that becomes a markdown document any AI assistant can read directly. No video is ever recorded live; transcription + screenshot-grounded cleanup via OpenRouter (BYOK), everything in-browser.",
  "icon": "🎬",
  "version": "0.1.7",
  "status": "alpha",
  "category": "media",
  "keywords": [
    "narrate",
    "review",
    "screenshot",
    "screen",
    "transcribe",
    "markdown",
    "pairs",
    "openrouter",
    "feedback",
    "video",
    "video-import",
    "screencast",
    "billing",
    "costs",
    "audit"
  ],
